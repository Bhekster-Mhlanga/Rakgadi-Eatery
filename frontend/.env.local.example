# Copy this file to .env.local and fill in your values (Supabase -> Project Settings -> API Keys).
# .env.local is ignored by git. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret (Supabase -> Project Settings -> API Keys -> "service_role" / secret key).
# Used only so people can log in with a phone number. It bypasses all database security:
# never prefix it with NEXT_PUBLIC_, never paste it in chat, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
